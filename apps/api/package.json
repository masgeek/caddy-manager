{
  "name": "@caddy-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "caddy:housekeep": "tsx src/housekeep.ts",
    "caddy:reconcile": "tsx src/reconcile.ts",
    "dev": "tsx --watch src/index.ts",
    "lint": "eslint src/",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@caddy-manager/config": "workspace:*",
    "@caddy-manager/db": "workspace:*",
    "@caddy-manager/shared-api": "workspace:*",
    "@caddy-manager/shared-types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.3.0",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "rotating-file-stream": "^3.2.10",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
