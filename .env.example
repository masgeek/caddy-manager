# Required
JWT_SECRET=  # generate with: openssl rand -base64 32

# Caddy Admin API
CADDY_ADMIN_TOKEN=  # optional, if Caddy admin API requires token auth
CADDY_ALLOWED_HOSTS=localhost,127.0.0.1,caddy  # comma-separated exact Caddy API hostnames/IPs
ALLOW_PRIVATE_OUTBOUND=false  # set true only when private health targets are required

# Server
PORT=3500
IMAGE_REGISTRY=ghcr.io/masgeek
LOG_LEVEL=info
LOG_FILE=logs/caddy-manager.log
# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caddy
DB_USER=caddy
DB_PASSWORD=caddy

# Seed
SEED_EMAIL=admin@caddy.local
SEED_USERNAME=admin
SEED_PASSWORD=  # required for `pnpm seed`
SEED_ROLE=admin
