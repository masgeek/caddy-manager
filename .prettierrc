{
  "plugins": [
    "prettier-plugin-multiline-arrays"
  ],
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "multilineArraysWrapThreshold": 0,
  "multilineArraysLinePattern": "1"
}
